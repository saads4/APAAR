# Copy to .env. NEVER reuse these values in a real deployment.
SECRET_KEY=change-me-to-a-long-random-string-0123456789
HASH_KEY=change-me-too-this-keys-the-apaar-id-hashes
POSTGRES_PASSWORD=sentinel
# true = demo accounts' hints, mock OTP inbox and demo-MFA helper are exposed. MUST be false outside a demo.
DEMO_MODE=true
SEED_DEMO_DATA=true
ACCESS_TOKEN_MINUTES=120
RATE_LIMIT_PER_MIN=600
# Optional: base64 raw Ed25519 private key. If empty, one is generated into DATA_DIR on first start.
SIGNING_KEY=
